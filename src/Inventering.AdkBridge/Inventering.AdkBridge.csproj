<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Liten konsolprocess som gör allt ADK-arbete. AdkNet4Wrapper.dll är C++/CLI för .NET Framework
    och kan inte laddas i .NET 8 – därför körs ADK i en egen 32-bitars .NET Framework 4.8-process
    som webbtjänsten startar per anrop (JSON in via stdin, JSON ut via stdout).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AdkLibDir Condition="'$(AdkLibDir)' == ''">$(MSBuildThisFileDirectory)..\..\lib\</AdkLibDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AvSynkLib"><HintPath>$(AdkLibDir)AvSynkLib.dll</HintPath></Reference>
    <Reference Include="AdkNet4Wrapper"><HintPath>$(AdkLibDir)AdkNet4Wrapper.dll</HintPath></Reference>
    <Reference Include="System.Data" />
  </ItemGroup>
</Project>
