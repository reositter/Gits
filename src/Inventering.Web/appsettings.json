{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "DataDirectory": "",

  "Visma": {
    "Mode": "Fake",
    "ArticleRefreshMinutes": 15,
    "Adk": {
      "CommonPath": "",
      "BridgePath": "AdkBridge\\Inventering.AdkBridge.exe",
      "TimeoutSeconds": 600
    }
  },

  "Https": {
    "Mode": "None",
    "PublicHost": "",
    "Port": 443,
    "RedirectHttp": true,
    "RootCaFile": ""
  },

  "Security": {
    "RequireTotpForAdmin": true,
    "RequireTotpForAll": false,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "SessionHours": 12,
    "MinPasswordLength": 10,
    "TotpIssuer": "Inventering"
  },

  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5080" }
    }
  }
}
